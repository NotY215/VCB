export function i32 get7() {
entry:
    ret i32 7
}

export function i32 plus3(i32 %1, i32 %2, i32 %3) {
entry:
    %4 = add i32 %1, %2
    %5 = add i32 %4, %3
    ret i32 %5
}

export function i32 main() {
entry:
    %1 = add i32 10, 0
    %2 = add i32 20, 0
    %3 = add i32 5, 0
    %4 = call i32 plus3(%1, %2, %3)
    ret i32 %4
}